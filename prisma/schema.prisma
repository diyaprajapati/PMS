// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  DEVELOPER
  CLIENT
}

enum SprintStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  P0 // Critical
  P1 // High
  P2 // Medium High
  P3 // Medium
  P4 // Low
  P5 // Lowest
}

enum BugStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  FIXED
  CLOSED
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String?
  name               String?
  image              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  ownedProjects      Project[]       @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  bugComments        BugComment[]
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  bugCounter  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  owner       User            @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  sprints     Sprint[]
  tasks       Task[]
  bugs        Bug[]

  @@index([userId])
}

model ProjectMember {
  id            String      @id @default(uuid())
  projectId     String
  userId        String
  role          ProjectRole @default(CLIENT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  assignedBugs  Bug[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Sprint {
  id        String       @id @default(uuid())
  title     String
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(NOT_STARTED)
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, title])
  @@index([projectId])
  @@index([projectId, status])
}

model Task {
  id                 String         @id @default(uuid())
  title              String
  description        String?        @db.Text
  acceptanceCriteria String?        @db.Text
  status             TaskStatus     @default(TODO)
  priority           TaskPriority   @default(P3)
  estimatedHours     Decimal?       @db.Decimal(10, 2)
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId           String?
  sprint             Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assigneeId         String?
  assignee           ProjectMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  parentTaskId       String?
  parentTask         Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks           Task[]         @relation("TaskSubtasks")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([projectId, sprintId])
  @@index([projectId, status])
}

model Bug {
  id          String         @id @default(uuid())
  bugNumber   Int
  title       String
  description String?        @db.Text
  priority    TaskPriority   @default(P3)
  status      BugStatus      @default(NOT_STARTED)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    ProjectMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    BugComment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([projectId, bugNumber])
  @@index([projectId])
  @@index([assigneeId])
  @@index([projectId, priority])
}

model BugComment {
  id        String   @id @default(uuid())
  bugId     String
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bugId])
  @@index([authorId])
  @@index([bugId, createdAt])
}
